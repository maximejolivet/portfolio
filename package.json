{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "version": "1.2.52",
  "repository": "git@github.com:maximejolivet/portfolio.git",
  "author": "Maxime JOLIVET <maximejolivet.pro@gmail.com>",
  "license": "MIT",
  "scripts": {
    "icons:generate": "node scripts/generate-icon-subset.mjs",
    "pdf-worker:copy": "node scripts/copy-pdf-worker.mjs",
    "update-date": "node scripts/update-compatibility-date.mjs",
    "predev": "npm run update-date && npm run icons:generate && npm run pdf-worker:copy",
    "prebuild": "npm run icons:generate && npm run pdf-worker:copy",
    "pregenerate": "npm run icons:generate && npm run pdf-worker:copy",
    "predeploy": "npm run icons:generate && npm run pdf-worker:copy",
    "deploy": "nuxt build && nuxt generate",
    "build": "nuxt build",
    "dev": "nuxt dev --no-fork",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run icons:generate && npm run pdf-worker:copy",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "html-encoding-sniffer": "4.0.0",
    "jsdom": "26.1.0",
    "@intlify/shared": "11.4.24",
    "@intlify/core-base": "11.4.23",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "readdir-glob": "^4.0.0"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.84",
    "@iconify-json/devicon-plain": "^1.2.75",
    "@iconify-json/logos": "^1.2.21",
    "@iconify-json/lucide": "^1.2.159",
    "@iconify-json/material-icon-theme": "^1.2.77",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/selfhst": "^1.2.34",
    "@iconify-json/skill-icons": "^1.2.4",
    "@nuxt/devtools": "^4.2.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.2.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/eslint": "^9.6.1",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "lint-staged": "^17.6.2",
    "nuxt": "^4.7.0",
    "nuxt-security": "^2.7.0",
    "pdfjs-viewer-element": "^4.2.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-i18n": "^11.4.23"
  },
  "lint-staged": {
    "*.(json|js|ts|vue)": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@nuxt/image": "^2.2.1",
    "@supabase/supabase-js": "^2.119.2",
    "isomorphic-dompurify": "^4.9.0",
    "opentype.js": "^2.0.0",
    "qrcode": "^1.5.4",
    "swiper": "^14.4.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
